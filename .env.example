# =============================================================================
# Dox — Environment Configuration
# Copy this file to .env and fill in values for your environment.
# Every key here maps directly to a Settings field.
# Format: DOX_{SECTION}__{KEY} for nested settings.
# =============================================================================

# Platform
DOX_ENVIRONMENT=dev
DOX_SECRET_KEY=change-me-in-production-use-256-bit-random-value

# Database
DOX_DATABASE__URL=postgresql+asyncpg://dox:dox_dev@localhost:5432/dox
DOX_DATABASE__POOL_SIZE=10
DOX_DATABASE__MAX_OVERFLOW=20

# Redis
DOX_REDIS__URL=redis://localhost:6379/0

# Adapters — controls which backend is used for each integration point
DOX_ADAPTERS__EVENT_BUS=redis_streams
DOX_ADAPTERS__OBJECT_STORE=local_fs
DOX_ADAPTERS__LOCAL_FS_PATH=local_fs_store
DOX_ADAPTERS__SECRET_STORE=env
DOX_ADAPTERS__METRICS=prometheus

# Sentinel
DOX_SENTINEL__ENABLED=true
DOX_SENTINEL__RUN_MODE=async

# Retention
DOX_RETENTION__HOT_DAYS=30
DOX_RETENTION__WARM_DAYS=90
DOX_RETENTION__COLD_DAYS=365
DOX_RETENTION__DELETE_AFTER_DAYS=730

# Platform signing keys (RSA-2048, base64-encoded PEM)
# Generate with: openssl genrsa -out private.pem 2048 && base64 -w0 private.pem
DOX_PLATFORM__SIGNING_KEY_PRIVATE=
DOX_PLATFORM__SIGNING_KEY_PUBLIC=
