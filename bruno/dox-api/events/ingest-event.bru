meta {
  name: Ingest Single Event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "event_id": "00000000-0000-0000-0000-000000000001",
    "schema_version": "1.0",
    "trace_id": "00000000-0000-0000-0000-000000000002",
    "session_id": "00000000-0000-0000-0000-000000000003",
    "correlation_id": "00000000-0000-0000-0000-000000000004",
    "tenant_id": "{{tenantId}}",
    "agent_id": "{{agentId}}",
    "agent_version": "1.0.0",
    "event_type": "tool_call_started",
    "environment": "prod",
    "timestamp": "2026-01-01T12:00:00Z",
    "client_timestamp": "2026-01-01T12:00:00Z",
    "payload": {
      "tool": "web_search",
      "query": "AI governance best practices"
    },
    "tags": {}
  }
}

docs {
  Valid event_type values:
    user_input_received, agent_started, agent_step_started, agent_step_completed,
    model_called, model_response_received, reasoning_captured,
    tool_selected, tool_call_started, tool_call_completed, tool_call_failed, tool_call_blocked,
    memory_read, memory_write_requested, memory_write_approved, memory_write_blocked, memory_rollback,
    rag_query, rag_chunk_retrieved,
    policy_evaluated, policy_failed,
    sentinel_alert_created, intervention_requested, intervention_applied,
    delegation_started, delegation_completed,
    consent_checked,
    agent_completed, agent_failed, agent_paused, agent_resumed, agent_terminated,
    replay_started, replay_completed

  Valid environment values: dev, test, staging, prod
}
